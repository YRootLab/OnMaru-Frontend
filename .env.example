# Public example only. Do not put real secrets in this file.

# 온마루 백엔드 (FE 카카오 로그인 가이드: 이 값 하나만 있으면 로그인 동작)
NEXT_PUBLIC_API_URL=https://onmaru-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://onmaru-backend.onrender.com

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=replace-with-clarity-project-id

# 한국관광공사 Odii (오디) 오디오 가이드 API
ODII_API_URL=https://apis.data.go.kr/B551011/Odii
ODII_API_KEY=replace-with-data-go-kr-odii-service-key
NEXT_PUBLIC_ODII_API_URL=https://apis.data.go.kr/B551011/Odii
NEXT_PUBLIC_ODII_API_KEY=replace-with-public-odii-key-if-required

# 한국관광공사 국문 관광정보 서비스
TOUR_API_KEY=replace-with-data-go-kr-tour-service-key
TOUR_API_VISITOR_KEY=replace-with-visitor-key
TOUR_API_CONGESTION_KEY=replace-with-congestion-key
TOUR_API_ENG_KEY=replace-with-eng-key
TOUR_API_RELATED_KEY=replace-with-related-key
TOUR_API_DEMAND_KEY=replace-with-demand-key

# Kakao (지도 SDK용 — 로그인은 백엔드가 전담하므로 FE에 카카오 로그인 키는 불필요)
KAKAO_MAP_KEY=replace-with-kakao-map-key
NEXT_PUBLIC_KAKAO_MAP_KEY=replace-with-kakao-map-key

# Gemini
GEMINI_API_KEY=replace-with-gemini-key
